    <string name="feature_startup_notice">启动提示</string>
    <string name="feature_startup_notice_summary">微信启动时提示「已注入」，解析 dex 完成后再提示一次；提示 3 秒后自动消失</string>

    <string name="feature_diagnostic">详细诊断</string>
    <string name="feature_diagnostic_summary">逐条显示自检结果与每个功能的装载情况，排查时开启</string>
    <string name="action_rescan">重新解析微信（清缓存）</string>
    <string name="action_rescan_summary">改过实现或换了微信版本后点一下，下次启动微信会重新扫描</string>
    <string name="rescan_done">已重扫完成，请完全重启微信</string>

    <string name="action_kill">一键结束微信后台</string>
    <string name="action_kill_summary">需要 root 权限。等同于「从最近任务划掉」，下次打开是真正的冷启动</string>
    <string name="kill_running">正在结束微信…</string>
    <string name="kill_ok">已结束微信后台，重新打开即可生效</string>
    <string name="kill_fail">执行失败：未获得 root 权限，或系统拦截了 su</string>

    <string name="feature_recall_notice">撤回时显示详情</string>
    <string name="feature_recall_notice_summary">拦截后弹出浮层，显示是谁撤回了什么内容，必须手动点「知道了」才会消失——锁屏时也会排队，不会错过</string>
    <string name="recall_notice_template_hint">提示模板：$sender=撤回者，$content=被撤回的内容</string>
    <string name="feature_recall_confirm">拦截提示常驻</string>
    <string name="feature_recall_confirm_summary">拦截撤回后的提示不会自动消失，必须手动点「知道了」才关闭；关闭此项则恢复 3 秒自动消失</string>
    <string name="feature_recall_self">也拦截自己撤回的</string>
    <string name="feature_recall_self_summary">开启后，自己发出又撤回的消息也会被拦截并提示（默认关闭：自己撤回时让微信正常撤掉）</string>

    <!-- 提示 -->
    <string name="status_scope">作用范围：com.tencent.mm，仅主进程</string>
    <string name="settings_entry_hint">入口：桌面「MM」图标；或在 LSPosed 中长按本模块 → 打开应用。</string>
    <string name="status_hint">修改开关后需完全重启微信才会生效；开启的功能可即时热装载，关闭的仍需重启。可用下方「一键结束微信后台」代替手动划掉。</string>
    <string name="settings_debug_hint">若功能无效：在 LSPosed 的日志中过滤 Wxcj，查看各项定位是否成功；并确认模块已启用、作用域包含微信，且已强制停止并重开微信。</string>
    <string name="footer_credit">本工具仅供测试 By Victoys</string>
</resources>
