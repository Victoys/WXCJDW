<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">MM</string>
    <!-- LSPosed 模块列表里显示的描述，保持中性 -->
    <string name="xposed_description">MM</string>

    <!-- 功能 -->
    <string name="feature_anti_recall">消息防撤回</string>
    <string name="feature_anti_recall_summary">拦截对方发送过来又撤回的消息</string>
    <string name="feature_disable_typing">禁止上传「正在输入」</string>
    <string name="feature_disable_typing_summary">阻止微信上传输入状态，对方看不到「对方正在输入...」</string>
    <string name="feature_disable_pat">禁用拍一拍</string>
    <string name="feature_disable_pat_summary">双击他人头像时不发送拍一拍</string>

    <string name="feature_fake_location">虚拟定位</string>
    <string name="feature_fake_location_summary">向微信提供设定坐标（发送位置、附近的人、小程序定位等都会用它）。只作用于微信，不影响其他 App，也不需要「模拟位置」权限</string>
    <string name="fake_lat_hint">纬度（-90~90）</string>
    <string name="fake_lng_hint">经度（-180~180）</string>
    <string name="fake_jitter_hint">随机抖动（米），0 = 关闭</string>
    <string name="fake_location_hint">坐标要自己填：在地图 App 里长按取点后抄过来，或用下面的常用位置 / 粘贴按钮。改坐标即时生效，不必重启微信</string>
    <string name="action_paste_coord">粘贴</string>
    <string name="paste_empty">剪贴板里没有可识别的坐标</string>
    <string name="paste_done">已填入：%1$s, %2$s</string>
    <string name="coord_invalid">坐标超出范围，已恢复为上一有效值</string>

